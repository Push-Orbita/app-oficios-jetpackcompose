<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash de sistema (tema claro), sin icon background:
    canvas 288dp, círculo visible 192dp. El isotipo navy-outlined
    (Figma 736:40) va centrado a 74×130 (insets 107/79) para entrar
    entero en el círculo, también si el mask baja a 160dp.
    No pintar el canvas de color: el fondo es windowSplashScreenBackground.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size
                android:width="@dimen/oficios_splash_icon_canvas"
                android:height="@dimen/oficios_splash_icon_canvas" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item
        android:width="@dimen/oficios_splash_isotype_outline_width"
        android:height="@dimen/oficios_splash_isotype_height"
        android:gravity="center"
        android:left="@dimen/oficios_splash_isotype_inset_horizontal_outline"
        android:top="@dimen/oficios_splash_isotype_inset_vertical"
        android:right="@dimen/oficios_splash_isotype_inset_horizontal_outline"
        android:bottom="@dimen/oficios_splash_isotype_inset_vertical"
        android:drawable="@drawable/ic_oficios_logotipo_outline" />
</layer-list>
