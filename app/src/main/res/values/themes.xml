<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Oficios" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Fondo de ventana = splash (hueso en claro, navy en values-night).
             Evita el flash del tema contrario antes de que Compose pinte. -->
        <item name="android:windowBackground">@color/oficios_splash_background</item>
    </style>

    <style name="Theme.Oficios.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/oficios_splash_background</item>
        <!-- Icono plano del mismo azul: el lockup (isotipo + wordmark) vive en Compose, centrado. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_compat</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/oficios_splash_background</item>
        <item name="postSplashScreenTheme">@style/Theme.Oficios</item>
    </style>
</resources>
