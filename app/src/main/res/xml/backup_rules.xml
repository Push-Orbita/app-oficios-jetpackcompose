<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup para Android 11 (API 30) o menor (android:fullBackupContent).
   Android 12+ usa data_extraction_rules.xml.

   La sesión cifrada (AppConstants.SESSION_PREFS_NAME) NO se respalda: la MasterKey vive en el
   Keystore del equipo y no viaja en el backup, así que restaurar el archivo deja un keyset que
   no se puede descifrar y la app crasheaba al abrir.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="oficios_session_encrypted.xml" />
</full-backup-content>
