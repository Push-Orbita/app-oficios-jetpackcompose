<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash de sistema (tema oscuro), sin icon background:
    canvas 288dp, círculo visible 192dp. Isotipo plano (Figma 666:2)
    casco azul + pin blanco a 66×120 (insets 111/84), contraste
    sobre navy #00358B.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size
                android:width="@dimen/oficios_splash_icon_canvas"
                android:height="@dimen/oficios_splash_icon_canvas" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item
        android:width="@dimen/oficios_splash_isotype_width"
        android:height="@dimen/oficios_splash_isotype_height"
        android:gravity="center"
        android:left="@dimen/oficios_splash_isotype_inset_horizontal"
        android:top="@dimen/oficios_splash_isotype_inset_vertical"
        android:right="@dimen/oficios_splash_isotype_inset_horizontal"
        android:bottom="@dimen/oficios_splash_isotype_inset_vertical"
        android:drawable="@drawable/ic_oficios_logotipo" />
</layer-list>
